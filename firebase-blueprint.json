{
  "entities": {
    "property": {
      "title": "Property",
      "description": "Etosmania Global Properties Investment Limited property & land catalog item",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "slug": { "type": "string" },
        "price": { "type": "number" },
        "mode": { "type": "string", "enum": ["sale", "rent"] },
        "type": { "type": "string" },
        "location": { "type": "string" },
        "address": { "type": "string" },
        "bedrooms": { "type": "number" },
        "bathrooms": { "type": "number" },
        "sizeSqm": { "type": "number" },
        "parkingSpaces": { "type": "number" },
        "yearBuilt": { "type": "string" },
        "furnished": { "type": "boolean" },
        "status": { "type": "string" },
        "featured": { "type": "boolean" },
        "description": { "type": "string" },
        "features": { "type": "array" },
        "images": { "type": "array" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "title", "price", "mode", "location", "address", "createdAt"]
    },
    "development": {
      "title": "Development",
      "description": "Multi-unit off-plan or completed real estate development project in Lagos",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "slug": { "type": "string" },
        "location": { "type": "string" },
        "address": { "type": "string" },
        "developer": { "type": "string" },
        "status": { "type": "string", "enum": ["Off-plan", "Ready", "Selling Fast"] },
        "startingPrice": { "type": "number" },
        "overview": { "type": "string" },
        "unitTypes": { "type": "array" },
        "paymentPlan": { "type": "object" },
        "masterplanImage": { "type": "string" },
        "images": { "type": "array" },
        "amenities": { "type": "array" },
        "timeline": { "type": "array" },
        "faqs": { "type": "array" },
        "mapQuery": { "type": "string" },
        "featured": { "type": "boolean" }
      },
      "required": ["id", "name", "location", "developer", "status", "startingPrice"]
    },
    "service": {
      "title": "Service",
      "description": "Core real estate pillar or advisory service offering managed via Admin CMS",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "number": { "type": "string" },
        "title": { "type": "string" },
        "shortDesc": { "type": "string" },
        "fullDesc": { "type": "string" },
        "deliverables": { "type": "array" },
        "ctaText": { "type": "string" },
        "image": { "type": "string" }
      },
      "required": ["id", "title"]
    },
    "coOwnershipAsset": {
      "title": "CoOwnershipAsset",
      "description": "Fractional real estate co-ownership syndicate asset",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "location": { "type": "string" },
        "address": { "type": "string" },
        "totalValue": { "type": "number" },
        "pricePerSlot": { "type": "number" },
        "totalSlots": { "type": "number" },
        "availableSlots": { "type": "number" },
        "expectedAnnualYield": { "type": "string" },
        "holdPeriod": { "type": "string" },
        "titleDocument": { "type": "string" },
        "image": { "type": "string" },
        "highlights": { "type": "array" },
        "category": { "type": "string" }
      },
      "required": ["id", "title", "location", "pricePerSlot", "totalSlots"]
    },
    "booking": {
      "title": "InspectionBooking",
      "description": "Client property inspection booking request",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "propertyId": { "type": "string" },
        "propertyTitle": { "type": "string" },
        "fullName": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "preferredDate": { "type": "string" },
        "preferredTime": { "type": "string" },
        "inspectionType": { "type": "string" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "fullName", "phone", "createdAt", "status"]
    },
    "inquiry": {
      "title": "ContactInquiry",
      "description": "Inbound client contact or service inquiry",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "fullName": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "interestType": { "type": "string" },
        "budgetRange": { "type": "string" },
        "preferredLocation": { "type": "string" },
        "message": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "fullName", "phone", "createdAt"]
    },
    "landingConfig": {
      "title": "LandingConfig",
      "description": "Etosmania Global Properties landing page CMS configuration, hero style mode, hero photos, headlines, and admin gate security settings",
      "type": "object",
      "properties": {
        "heroStyle": { "type": "string", "enum": ["full-bleed", "split"] },
        "heroBadge": { "type": "string" },
        "heroTitleLine1": { "type": "string" },
        "heroTitleAccent": { "type": "string" },
        "heroSubtitle": { "type": "string" },
        "heroImage": { "type": "string" },
        "heroSecondaryImage": { "type": "string" },
        "featuredBannerTitle": { "type": "string" },
        "featuredBannerLocation": { "type": "string" },
        "gatePassword": { "type": "string", "maxLength": 128 },
        "updatedAt": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/properties/{propertyId}": {
      "schema": "property",
      "description": "Catalog of luxury properties and verified land in Lagos"
    },
    "/developments/{developmentId}": {
      "schema": "development",
      "description": "Catalog of off-plan and completed real estate developments in Lagos"
    },
    "/services/{serviceId}": {
      "schema": "service",
      "description": "Catalog of advisory and brokerage services"
    },
    "/servicesCatalog/{serviceId}": {
      "schema": "service",
      "description": "Active CMS catalog of real estate service pillars"
    },
    "/coOwnershipCatalog/{assetId}": {
      "schema": "coOwnershipAsset",
      "description": "Active CMS catalog of fractional co-ownership assets"
    },
    "/bookings/{bookingId}": {
      "schema": "booking",
      "description": "Property inspection bookings"
    },
    "/inquiries/{inquiryId}": {
      "schema": "inquiry",
      "description": "Client contact and advisory inquiries"
    },
    "/enquiries/{enquiryId}": {
      "schema": "inquiry",
      "description": "Legacy inbound enquiries"
    },
    "/siteSettings/{settingId}": {
      "schema": "landingConfig",
      "description": "Active landing page CMS configuration"
    },
    "/settings/{settingId}": {
      "schema": "landingConfig",
      "description": "Website CMS settings and adminSecurity gate password"
    }
  }
}
