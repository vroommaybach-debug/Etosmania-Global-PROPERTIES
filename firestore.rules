rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidAdminSecurityPayload(data) {
      return (!('gatePassword' in data) || (data.gatePassword is string && data.gatePassword.size() >= 6 && data.gatePassword.size() <= 128));
    }

    // Properties collection: Public read (get & list) for property seekers; write permitted for catalog management
    match /properties/{propertyId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(propertyId);
    }

    // Developments collection: Public read (get & list); write permitted for development management
    match /developments/{developmentId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(developmentId);
    }

    // Services collections: Public read (get & list); write permitted for advisory services management
    match /services/{serviceId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(serviceId);
    }

    match /servicesCatalog/{serviceId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(serviceId);
    }

    // Co-Ownership Catalog collection: Public read (get & list); write permitted for co-ownership management
    match /coOwnershipCatalog/{assetId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(assetId);
    }

    // Bookings & Inquiries collections: Public create for site visitors; read/update/delete for admin desk management
    match /bookings/{bookingId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(bookingId);
    }

    match /inquiries/{inquiryId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(inquiryId);
    }

    match /enquiries/{enquiryId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(enquiryId);
    }

    // Site Settings & Admin Gate Security
    match /siteSettings/{settingId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(settingId);
    }

    match /settings/{settingId} {
      allow get, list: if true;
      allow create, update: if isValidId(settingId) && isValidAdminSecurityPayload(request.resource.data);
      allow delete: if isValidId(settingId);
    }

    // Connection health check path
    match /test/{testId} {
      allow get, list: if true;
    }

    // Default fallback deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
